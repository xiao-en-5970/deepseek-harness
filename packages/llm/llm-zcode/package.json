{
  "name": "@deepseek-ai/dsh-llm-zcode",
  "description": "ZCode app-server agent proxy for DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
